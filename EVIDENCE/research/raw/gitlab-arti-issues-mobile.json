[{"id":341883,"iid":2828,"project_id":647,"title":"Question: stream isolation guidance for an embedded Arti client carrying both Nostr relay and Zcash light-wallet traffic on mobile","description":"Hello,\n\nI am building Shielded Mesh, a fork of bitchat (iOS and Android) that embeds Arti in-process, as bitchat already does. I am not seeking funding, press or users. Please relabel or close this if a question is not appropriate for the tracker.\n\nThe app sends two kinds of traffic over Arti: Nostr relay websockets, and Zcash light-wallet sync (gRPC to lightwalletd servers). I want to stop an exit or a server from linking a user's messaging identity to their wallet activity through shared circuits.\n\nQuestions:\n\n1. Is it the recommended Arti API pattern to use separate isolation groups (IsolationToken or equivalent) for each traffic class, and possibly per Nostr identity?\n2. Are there known costs or pitfalls with keeping several isolated long-lived streams open on mobile (battery, circuit build limits, background suspension on iOS)?\n\nFull design note available on request.\n\nThank you,\nRita, Planetary Perspective","state":"opened","created_at":"2026-10-26T09:16:35.196Z","updated_at":"2026-10-26T09:16:35.196Z","closed_at":null,"closed_by":null,"labels":[],"milestone":null,"assignees":[],"author":{"id":4520,"username":"anonticket","public_email":null,"name":"anonticket","state":"active","locked":false,"avatar_url":null,"web_url":"https://gitlab.torproject.org/anonticket"},"type":"ISSUE","assignee":null,"user_notes_count":0,"merge_requests_count":0,"upvotes":0,"downvotes":0,"start_date":null,"due_date":null,"confidential":false,"discussion_locked":null,"issue_type":"issue","web_url":"https://gitlab.torproject.org/tpo/core/arti/-/work_items/2828","time_stats":{"time_estimate":0,"total_time_spent":0,"human_time_estimate":null,"human_total_time_spent":null},"task_completion_status":{"count":0,"completed_count":0},"weight":null,"blocking_issues_count":0,"has_tasks":t