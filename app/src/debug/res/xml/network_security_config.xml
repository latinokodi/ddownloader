<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG-ONLY override. The release config (src/main/res/xml/network_security_config.xml)
  permits cleartext *only* on loopback. Verification runs on the emulator against a
  fixture server on the host, which the guest reaches at 10.0.2.2 — that host is
  allowed here, in debug builds only, so the differential/lifecycle tests can
  transfer known bytes over plain HTTP. Release APKs keep the strict policy.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">::1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
