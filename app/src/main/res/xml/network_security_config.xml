<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is disabled globally. The ONLY exception is the loopback
  interface, used by the app's own local test fixtures reached via `adb reverse`
  (debug/verify builds only; see src/debug and src/verify overrides).

  Every non-loopback origin must be HTTPS. There is no proxy: "tor" in this project
  means TorBox, the debrid service, not the Tor network. See DECISIONS.md, Decision A.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">::1</domain>
    </domain-config>
</network-security-config>
