<?xml version="1.0" encoding="utf-8"?>
<!--
  Sensitive data must never leave the device: debrid OAuth tokens, the TMDB key
  and database rows are excluded from cloud backup AND device-to-device transfer.
  android:allowBackup="false" already disables both; these rules are explicit
  defence-in-depth so a future flip of allowBackup cannot silently leak them.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
